[Unit]
Description=Pi Coding Agent Gateway (WhatsApp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=GATEWAY_PLATFORM=whatsapp
ExecStart=@@EXT_DIR@@/scripts/pi-rpc-wrapper.sh whatsapp
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
